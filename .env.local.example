# Copy to .env.local and fill in. Never commit real values.

# Public site URL (no trailing slash) — used for canonical, sitemap, OG, JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode bypasses ALL authentication (investor demo only). Leave unset/false in real environments.
NEXT_PUBLIC_DEMO_MODE=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — TEST keys only until launch (pk_test_… / sk_test_…).
# In demo mode (NEXT_PUBLIC_DEMO_MODE=true) the API refuses any sk_live_ key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Only needed for real bookings (not demo): from `stripe listen` or the dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=

# WhatsApp concierge, international digits only. Default in code: 33663907888 (temporary). Empty string = buttons hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Emails transactionnels (Resend). Sans clé : rien n'est envoyé (affichage console en dev, ignoré en production).
RESEND_API_KEY=
# Expéditeur : le domaine doit être vérifié chez Resend (SPF + DKIM).
EMAIL_FROM="Ohaana <contact@ohaana.fr>"
# Jeton de la tâche planifiée /api/cron/daily (Vercel l'envoie en « Authorization: Bearer »). Sans lui, la route refuse tout.
CRON_SECRET=
# Webhook Stripe des comptes connectés (paiements directs) : un second endpoint, son propre secret.
STRIPE_CONNECT_WEBHOOK_SECRET=
