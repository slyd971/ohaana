# Copy to .env.local and fill in. Never commit real values.

# Public site URL (no trailing slash) — used for canonical, sitemap, OG, JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode bypasses ALL authentication (investor demo only). Leave unset/false in real environments.
NEXT_PUBLIC_DEMO_MODE=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (use test keys outside production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp concierge, international digits only. Default in code: 33663907888 (temporary). Empty string = buttons hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Transactional email (Resend)
RESEND_API_KEY=
