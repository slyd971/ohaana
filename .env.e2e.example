# Copy to .env.e2e (git-ignored). Used by tests/e2e/backoffice.spec.ts, which writes real rows
# in the Supabase project of .env.local: use dedicated TEST accounts, never real customers.
E2E_BACKOFFICE=1
# An admin account (role 'admin') and a provider account (role 'provider', approved), both e-mail + password.
# A Google-only account can get a password from /provider/settings ("Définir un mot de passe").
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PROVIDER_EMAIL=
E2E_PROVIDER_PASSWORD=
